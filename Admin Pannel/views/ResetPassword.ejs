<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>Admin Panel</title>
    <!-- Plugins: CSS -->
    <link
      rel="stylesheet"
      href="../../assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link
      rel="stylesheet"
      href="../../assets/vendors/css/vendor.bundle.base.css"
    />
    <!-- Layout Styles -->
    <link rel="stylesheet" href="../../assets/css/style.css" />
    <link rel="shortcut icon" href="../../assets/images/favicon.png" />
  </head>
  <body>
    <div class="container-scroller">
      <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="row w-100 m-0">
          <div
            class="content-wrapper full-page-wrapper d-flex align-items-center auth login-bg"
          >
            <div class="card col-lg-4 mx-auto">
              <div class="card-body px-5 py-5">
                <h3 class="card-title text-left mb-4">Reset Password</h3>

                <!-- Form for Sending OTP -->
                <form id="otp-form" action="/user/sendotp" method="post">
                  <label>Email *</label>
                  <input type="email" name="email" class="form-control p_input" />
                  <button type="submit" class="btn w-50 btn-primary btn-block enter-btn">
                    Send OTP
                  </button>
                </form>
                <div id="otp-success-popup" style="display: none; position: fixed; top: 20%; left: 50%; transform: translate(-50%, -50%); background: #28a745; color: #fff; padding: 20px; border-radius: 5px;">
                  OTP sent successfully!
                </div>
                <!-- Form for Resetting Password -->
                <form action="/user/resetpassword" method="post">
                  <div class="form-group">
                    <label>Enter OTP *</label>
                    <input
                      type="number"
                      name="otp"
                      class="form-control p_input"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label>Enter New Password *</label>
                    <input
                      type="password"
                      name="password"
                      class="form-control p_input"
                      required
                    />
                  </div>
                  <button
                    type="submit"
                    class="btn btn-primary btn-block enter-btn"
                  >
                    Forgot Password
                  </button>
                </form>
              </div>
            </div>
          </div>
          <!-- content-wrapper ends -->
        </div>
        <!-- row ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>


    
    <!-- container-scroller -->

    <!-- Plugins: JS -->
    <script src="../../assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="../../assets/js/off-canvas.js"></script>
    <script src="../../assets/js/hoverable-collapse.js"></script>
    <script src="../../assets/js/misc.js"></script>
    <script src="../../assets/js/settings.js"></script>
    <script src="../../assets/js/todolist.js"></script>
  </body>
</html>
